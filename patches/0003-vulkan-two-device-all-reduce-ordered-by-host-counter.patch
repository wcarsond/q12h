+// events mode: queue a wait for a host-set event, then reset it for its next use (the ring is 256 deep, so the
+// reset has long executed before the relay sets the event again).
+static void ggml_vk_comm_wait_event(vk_context & subctx, vk::Event event) {
+    vk::CommandBuffer & cb = subctx->s->buffer->buf;
+    cb.waitEvents({ event }, vk::PipelineStageFlagBits::eHost, vk::PipelineStageFlagBits::eAllCommands,
