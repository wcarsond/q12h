     for (int j = 0; j < 2; j++) {
         ggml_backend_vk_context * ctx = (ggml_backend_vk_context *) cc->backends[j]->context;
-        cc->host_buf[j] = ggml_vk_buffer_from_host_ptr(ctx->device, cc->host_mem, 2*slot);
+        cc->host_buf[j] = ggml_vk_buffer_from_host_ptr(ctx->device, cc->host_mem, host_size);
         cc->tmp_buf[j]  = ggml_backend_alloc_buffer(cc->backends[j], slot);
         if (cc->host_buf[j] == nullptr || cc->tmp_buf[j] == nullptr) {
-            GGML_LOG_WARN("%s: could not set up %zu-byte shared slots on device %d, using the generic all-reduce\n", __func__, slot, j);
+            GGML_LOG_WARN("%s: could not set up %d x %zu-byte shared slots on device %d, using the generic all-reduce for tensors this size\n", __func__, cc->n_slots, slot, j);
             ggml_vk_comm_release_buffers(cc);
+            cc->failed_bytes = nbytes;
             return false;
         }
     }
@@ -16416,10 +16459,88 @@ static bool ggml_vk_comm_reserve(ggml_vk_comm_context * cc, size_t nbytes) {
     return true;
 }
 
+// A timeline semaphore on device `owner` (signalled by its queue) and its mirror on the other device (host-signalled
+// by the relay thread, waited on by that device's queue). Both start at 0.
+static bool ggml_vk_comm_make_pair(ggml_vk_comm_context * cc, int owner, vk::Semaphore out[2]) {
+    for (int d = 0; d < 2; d++) {
+        vk::Device dev = ((ggml_backend_vk_context *) cc->backends[d]->context)->device->device;
+        vk::SemaphoreTypeCreateInfo tci{ vk::SemaphoreType::eTimeline, 0 };
+        vk::SemaphoreCreateInfo ci{};
+        ci.setPNext(&tci);
+        try {
+            out[d] = dev.createSemaphore(ci);
+        } catch (const vk::SystemError &) {
+            return false;
+        }
+    }
+    GGML_UNUSED(owner);
+    return true;
+}
+
+// The relay: whenever a device's "written" or "read" counter advances, host-signal the mirror on the other device.
+// Spins on one core; the counter reads are a few microseconds each.
+static void ggml_vk_comm_relay(ggml_vk_comm_context * cc) {
+    struct link {
+        VkDevice    src_dev;
+        VkSemaphore src;
+        int         dst;     // device index of the mirror
+        VkSemaphore mirror;
+        uint64_t    last;
+    };
+    link links[4];
+    int n = 0;
+    for (int j = 0; j < 2; j++) {
+        VkDevice dev_j = static_cast<VkDevice>(((ggml_backend_vk_context *) cc->backends[j]->context)->device->device);
+        links[n++] = { dev_j, cc->sem_written[j][j], 1 - j, cc->sem_written[j][1 - j], 0 };
+        links[n++] = { dev_j, cc->sem_read[j][j],    1 - j, cc->sem_read[j][1 - j],    0 };
+    }
+    VkDevice dst_dev[2];
+    for (int d = 0; d < 2; d++) {
+        dst_dev[d] = static_cast<VkDevice>(((ggml_backend_vk_context *) cc->backends[d]->context)->device->device);
+    }
+
+    int idle = 0;
+    while (!cc->relay_stop.load(std::memory_order_relaxed)) {
+        bool advanced = false;
+        for (link & l : links) {
+            uint64_t v = 0;
+            const int src = (l.dst == 1) ? 0 : 1;
+            if (cc->pfn_counter[src](l.src_dev, l.src, &v) == VK_SUCCESS && v > l.last) {
+                VkSemaphoreSignalInfo si = { VK_STRUCTURE_TYPE_SEMAPHORE_SIGNAL_INFO, nullptr, l.mirror, v };
+                cc->pfn_signal[l.dst](dst_dev[l.dst], &si);
+                l.last   = v;
+                advanced = true;
+            }
+        }
+        if (advanced) {
+            idle = 0;
+        } else if (++idle > 2000) {
+            std::this_thread::yield(); // nothing moving (between tokens, or the model is loading): give the core up
+        }
+    }
+}
+
+static void ggml_vk_comm_destroy_semaphores(ggml_vk_comm_context * cc) {
+    for (int j = 0; j < 2; j++) {
+        for (int d = 0; d < 2; d++) {
+            vk::Device dev = ((ggml_backend_vk_context *) cc->backends[d]->context)->device->device;
+            if (cc->sem_written[j][d]) {
+                dev.destroySemaphore(cc->sem_written[j][d]);
+                cc->sem_written[j][d] = nullptr;
+            }
+            if (cc->sem_read[j][d]) {
+                dev.destroySemaphore(cc->sem_read[j][d]);
+                cc->sem_read[j][d] = nullptr;
+            }
+        }
+    }
+}
