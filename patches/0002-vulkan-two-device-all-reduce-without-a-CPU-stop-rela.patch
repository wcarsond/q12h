@@ -16347,18 +16355,30 @@ static ggml_backend_dev_t ggml_backend_vk_reg_get_device(ggml_backend_reg_t reg,
 // per exchange: synchronize both, read one partial back to the CPU, write it to the other device, and the same the
 // other way. Measured on two Arc Pro B60s (Windows): ~190 us per exchange, two exchanges per layer.
 //
-// Here both devices import the same block of host memory (VK_EXT_external_memory_host), one slot per device:
+// Here both devices import the same block of host memory (VK_EXT_external_memory_host), a ring of slots per device:
 //   1. each device copies its partial into its own slot, queued behind the subgraph that produced it
-//   2. submit both devices, then wait for both: the only stop
+//   2. submit both devices
 //   3. each device copies the other device's slot into a local buffer and adds it to its partial, queued; the next
-//      subgraph runs behind it without another stop
+//      subgraph runs behind it
+// Two modes, chosen at init:
+//   async: each device signals a timeline semaphore of its own when its slot is written ("written") and when it has
+//          read the other's slot ("read"); the other device waits in-queue on a mirror semaphore of its own. A relay
+//          thread polls the source counters and host-signals the mirrors, so the main thread never waits and
+//          neither device drains. (Vulkan's external semaphores would do this without the thread, but on the Intel
+//          Windows driver an import between two physical devices succeeds and shares nothing; see vk-semaphore-probe.)
+//          "read" keeps the ring from being overwritten before it has been read.
+//   sync:  GGML_VK_COMM_SYNC=1, or the device serializes submissions: step 2 is one submit + wait on both devices.
 // Anything else (other device counts, non-F32, non-contiguous, no external_memory_host) gets nullptr/false and the
 // meta backend uses its generic all-reduce. GGML_VK_DISABLE_COMM=1 forces the generic path, for A/B races.
 
 struct ggml_vk_comm_context {
     ggml_backend_t        backends[2] = {};
+    bool                  async       = false;
+    int                   n_slots     = 1;       // ring depth per device (async, set by reserve), 1 in sync mode
+    size_t                failed_bytes = 0;      // smallest tensor size whose slots could not be set up (0: none)
+    uint64_t              seq         = 0;       // exchanges so far; the semaphore value of the current one
     uint8_t *             host_alloc  = nullptr; // as returned by malloc
-    uint8_t *             host_mem    = nullptr; // aligned: slot 0 at 0, slot 1 at slot_size
+    uint8_t *             host_mem    = nullptr; // aligned; device j's slot k at (j*n_slots + k)*slot_size
     size_t                slot_size   = 0;
     vk_buffer             host_buf[2];           // host_mem as a buffer on each device
     ggml_backend_buffer_t tmp_buf[2]  = {};      // on each device: where the other device's partial lands
@@ -16366,6 +16386,17 @@ struct ggml_vk_comm_context {
     ggml_tensor           node_add[2];
     ggml_context *        gctx        = nullptr; // holds the two one-node graphs
     ggml_cgraph *         graph[2]    = {};
+    // async: sem_written[j][j] is signalled by device j's queue when its slot holds exchange seq; sem_written[j][1-j]
+    // is the mirror on the other device, host-signalled by the relay thread, that device 1-j's queue waits on.
+    // sem_read likewise for "device j has read the other's slot of exchange seq".
+    vk::Semaphore         sem_written[2][2];
+    vk::Semaphore         sem_read[2][2];
+    std::thread           relay;
+    std::atomic<bool>     relay_stop { false };
+    PFN_vkGetSemaphoreCounterValue pfn_counter[2] = {}; // per device
+    PFN_vkSignalSemaphore          pfn_signal[2]  = {};
+
+    size_t slot_offset(int j, uint64_t s) const { return (j*n_slots + (size_t) (s % n_slots)) * slot_size; }
 };
 
