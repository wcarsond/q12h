+// MatM is 16 where the device offers 16x16x16, and 8 where it offers only 8x16x16 for f16 (observed on Intel Xe2, Arc Pro B60).
+// With MatM = 8 the P*V product walks the Br query rows in two 8-row tiles; the KV reduction stays in chunks of 16 (the tile's K).
+layout (constant_id = 16) const uint32_t MatM = 16;
 const uint32_t MatBr = 16;
-const uint32_t MatBc = 16;
+const uint32_t MatBc = MatM;
 
 const uint32_t rows_per_thread = Br / row_split;
 const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
@@ -53,12 +58,12 @@ shared ACC_TYPEV4 sfsh[Bc * sfshstride];
 
 const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
