diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 727256817..33625794e 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1286,24 +1286,50 @@ static vk_fa_tuning_params get_fa_tuning_params_coopmat1(const vk_device& device
     GGML_UNUSED(n_kv);
     GGML_UNUSED(k_type);
     GGML_UNUSED(v_type);
-    GGML_UNUSED(f32acc);
 
     vk_fa_tuning_params result{};
     result.path = FA_COOPMAT1;
 
     const uint32_t D = hsk | hsv;
 
+    // The cooperative-matrix tile is M x 16 x 16. Most devices offer M = 16; Intel Xe2 (observed: Arc Pro B60) offers only M = 8 for f16.
+    // The shader takes M as specialization constant 16 (MatM): the KV rows per subgroup in K*Q^T and the query rows per P*V tile.
+    const bool has16 = f32acc ? device->coopmat_support_16x16x16_f32acc : device->coopmat_support_16x16x16_f16acc;
+    const bool has8  = f32acc ? device->coopmat_support_8x16x16_f32acc  : device->coopmat_support_8x16x16_f16acc;
+    result.mat_m = has16 ? 16 : (has8 ? 8 : 0);
+
     const uint32_t coopmat_block_rows = 16;
-    const uint32_t coopmat_block_cols = 16;
+    const uint32_t coopmat_block_cols = result.mat_m ? result.mat_m : 16;
 
-    const uint32_t num_subgroups = 4;
+    // Intel executes cooperative-matrix ops at its minimum subgroup width (16 on Xe), as the coopmat1 matmul pipelines
+    // already assume.
+    result.subgroup_size = (device->vendor_id == VK_VENDOR_ID_INTEL && device->subgroup_size_control) ? device->subgroup_min_size : device->subgroup_size;
+
+    // Subgroups per workgroup (row_split). The shader requires:
+    //   block_rows / row_split to be a multiple of 4 (the softmax walks its rows four at a time), so row_split <= 4;
+    //   block_cols = M * row_split to be a multiple of 16 (the tile's K), so row_split >= 2 when M == 8;
+    //   block_cols >= subgroup_size and a multiple of it: the softmax column loops that write Psh (the P operand of
+    //   P*V) give each thread block_cols / subgroup_size columns, and zero columns means Psh is never written.
+    // With M == 8 that leaves 2 or 4 subgroups; 2 measured faster on Arc Pro B60 (pp512 at 16K depth: 341 vs 290 tok/s).
+    // If 2 would leave block_cols below the subgroup width (a 32-wide subgroup on an 8-row device), take 4 instead;
+    // get_fa_tuning_params checks the final topology and falls back to the scalar path if it still does not fit.
+    uint32_t num_subgroups = result.mat_m == 8 ? 2 : 4;
+    if (coopmat_block_cols * num_subgroups < result.subgroup_size) {
+        num_subgroups = 4;
+    }
 
     result.block_rows = coopmat_block_rows;
     result.block_cols = coopmat_block_cols * num_subgroups;
     result.row_split = num_subgroups;
-    result.subgroup_size = device->subgroup_size;
     result.workgroup_size = num_subgroups * result.subgroup_size;
 
+    // fixed relationships of this shader; a future constant change must not silently break them
+    GGML_ASSERT(result.block_rows == 16);
+    GGML_ASSERT(result.row_split > 0 && result.block_rows % result.row_split == 0);
+    GGML_ASSERT((result.block_rows / result.row_split) % 4 == 0);
+    GGML_ASSERT(result.block_cols == coopmat_block_cols * result.row_split && result.block_cols % 16 == 0);
+    GGML_ASSERT(result.workgroup_size == result.row_split * result.subgroup_size);
+
     const uint32_t D_lsb = D ^ (D & (D-1));  // extract lowest set bit
     result.d_split = std::min(std::min(result.subgroup_size, 8u), D_lsb / 4);
 
@@ -1357,12 +1383,14 @@ vk_fa_tuning_params get_fa_tuning_params(const vk_device& device, uint32_t hsk,
     }
 
     if (path == FA_COOPMAT1) {
-        bool shape_ok = (f32acc && device->coopmat_support_16x16x16_f32acc) ||
