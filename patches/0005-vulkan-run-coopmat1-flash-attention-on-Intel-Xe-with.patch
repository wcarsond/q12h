+        // the softmax gives each thread block_cols / subgroup_size columns; zero columns leaves Psh unwritten (see get_fa_tuning_params_coopmat1)
+        bool topology_ok = params.subgroup_size > 0 && params.block_cols >= params.subgroup_size && params.block_cols % params.subgroup_size == 0;
 
-        if (!shape_ok || !shmem_ok) {
+        if (!shape_ok || !shmem_ok || !topology_ok) {
             path = FA_SCALAR;
         }
     }
