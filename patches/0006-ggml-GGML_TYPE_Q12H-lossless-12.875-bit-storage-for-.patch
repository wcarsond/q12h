+// Q12H: lossless 12.875-bit storage for bf16 weights, block-local.
+//   lut[16]  - the block's 16 most frequent bf16 exponent bytes
+//   epos[4]  - exception positions (0..255), 0xFF = empty slot
+//   eval[4]  - exception values, raw bf16 bit patterns
+//   nib[128] - 4-bit LUT indices, two per byte, even index in low nibble
+//   sm[256]  - sign(1) << 7 | mantissa(7) per weight
+// Dequant: u16 = (sm>>7)<<15 | lut[nib]<<7 | (sm&0x7F); then <=4 overwrites
+// from the exception slots; bf16 -> f32 is (u16 << 16).
+#define QK12H 256
+typedef struct {
+    uint8_t  lut[16];
+    uint8_t  epos[4];
+    uint16_t eval[4];
+    uint8_t  nib[QK12H/2];
+    uint8_t  sm[QK12H];
+} block_q12h;
+static_assert(sizeof(block_q12h) == 16 + 4 + 8 + QK12H/2 + QK12H, "wrong q12h block size/padding");
+
 #define QK4_0 32
 typedef struct {
     ggml_half d;           // delta
