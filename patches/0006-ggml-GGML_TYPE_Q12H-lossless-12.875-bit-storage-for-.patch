+size_t quantize_q12h(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    UNUSED(quant_weights); // Q12H is lossless; an importance matrix has nothing to steer
+    const size_t row_size = ggml_row_size(GGML_TYPE_Q12H, n_per_row);
+    char * qrow = (char *)dst;
+    for (int64_t row = 0; row < nrow; ++row) {
+        quantize_row_q12h_ref(src, (block_q12h *)qrow, n_per_row);
+        src  += n_per_row;
+        qrow += row_size;
+    }
+    return nrow * row_size;
+}
