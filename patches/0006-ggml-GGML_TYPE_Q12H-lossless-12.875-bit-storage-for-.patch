+// ====================== Q12H (lossless 12.875-bit storage for bf16 weights)
+
+static inline uint16_t q12h_f32_to_bf16_bits(float f) {
+    // round-to-nearest-even; exact round-trip when f came from a bf16
+    uint32_t u;
+    memcpy(&u, &f, sizeof(u));
+    return (uint16_t)((u + 0x7FFF + ((u >> 16) & 1)) >> 16);
+}
+
+void quantize_row_q12h_ref(const float * GGML_RESTRICT x, block_q12h * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK12H == 0);
+    const int nb = k / QK12H;
+
+    for (int i = 0; i < nb; i++) {
+        uint16_t bits[QK12H];
+        int      cnt[256] = { 0 };
+        for (int j = 0; j < QK12H; j++) {
+            bits[j] = q12h_f32_to_bf16_bits(x[i*QK12H + j]);
+            cnt[(bits[j] >> 7) & 0xFF]++;
+        }
+        // top-16 exponents by count (count desc, value asc on ties: deterministic)
+        uint8_t inv[256];
+        memset(inv, 0xFF, sizeof(inv));
+        for (int s = 0; s < 16; s++) {
+            int best = -1;
+            for (int e = 0; e < 256; e++) {
+                if (inv[e] != 0xFF || cnt[e] == 0) continue;
+                if (best < 0 || cnt[e] > cnt[best]) best = e;
+            }
+            if (best < 0) {               // fewer than 16 distinct: pad LUT
+                y[i].lut[s] = y[i].lut[0];
+                continue;
+            }
+            y[i].lut[s] = (uint8_t)best;
+            inv[best]   = (uint8_t)s;
+        }
+        int ne = 0;
+        for (int s = 0; s < 4; s++) { y[i].epos[s] = 0xFF; y[i].eval[s] = 0; }
+        for (int j = 0; j < QK12H; j++) {
+            const uint8_t e  = (bits[j] >> 7) & 0xFF;
+            uint8_t       ix = inv[e];
+            if (ix == 0xFF) {             // not in top-16: exception slot
+                GGML_ASSERT(ne < 4 && "q12h: block needs >4 exception slots");
+                y[i].epos[ne] = (uint8_t)j;
+                y[i].eval[ne] = bits[j];
+                ne++;
+                ix = 0;                   // nibble content is irrelevant here
+            }
+            if (j & 1) y[i].nib[j >> 1] |= (uint8_t)(ix << 4);
+            else       y[i].nib[j >> 1]  = ix;
+            y[i].sm[j] = (uint8_t)((((bits[j] >> 15) & 1) << 7) | (bits[j] & 0x7F));
+        }
+    }
+}
+
+void dequantize_row_q12h(const block_q12h * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QK12H == 0);
+    const int nb = k / QK12H;
+
+    for (int i = 0; i < nb; i++) {
+        for (int j = 0; j < QK12H; j++) {
+            const uint8_t sm = x[i].sm[j];
+            const uint8_t ix = (j & 1) ? (x[i].nib[j >> 1] >> 4) : (x[i].nib[j >> 1] & 0xF);
+            uint16_t bits = (uint16_t)(((sm >> 7) << 15) | (x[i].lut[ix] << 7) | (sm & 0x7F));
+            uint32_t u = (uint32_t)bits << 16;
+            memcpy(&y[i*QK12H + j], &u, sizeof(float));
+        }
+        for (int s = 0; s < 4; s++) {
+            const uint8_t p = x[i].epos[s];
+            if (p == 0xFF) break;
+            const uint32_t u = (uint32_t)x[i].eval[s] << 16;
+            memcpy(&y[i*QK12H + p], &u, sizeof(float));
+        }
+    }
+}
