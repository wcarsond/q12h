+// Q12H x F32: src1 needs no conversion (vec_dot_type == GGML_TYPE_F32).
+// Correctness first - dequantize each 256-weight block to a local buffer and
+// accumulate against the f32 activations.
+void ggml_vec_dot_q12h_f32(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK12H;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q12h * GGML_RESTRICT x = vx;
+    const float      * GGML_RESTRICT y = vy;
+
+    float sumf = 0.0f;
+
+    for (int i = 0; i < nb; i++) {
+        float xb[QK12H];
+        for (int j = 0; j < qk; j++) {
+            const uint8_t sm = x[i].sm[j];
+            const uint8_t ix = (j & 1) ? (x[i].nib[j >> 1] >> 4) : (x[i].nib[j >> 1] & 0xF);
+            const uint16_t bits = (uint16_t)(((sm >> 7) << 15) | (x[i].lut[ix] << 7) | (sm & 0x7F));
+            const uint32_t u = (uint32_t)bits << 16;
+            memcpy(&xb[j], &u, sizeof(float));
+        }
+        for (int t = 0; t < 4; t++) {
+            const uint8_t p = x[i].epos[t];
+            if (p == 0xFF) break;
+            const uint32_t u = (uint32_t)x[i].eval[t] << 16;
+            memcpy(&xb[p], &u, sizeof(float));
+        }
+
+        const float * GGML_RESTRICT yb = y + (size_t)i*qk;
+        for (int j = 0; j < qk; j++) {
+            sumf += xb[j] * yb[j];
+        }
+    }
+
+    *s = sumf;
+}
