@@ -5509,6 +5597,30 @@ bool ggml_validate_row_data(enum ggml_type type, const void * data, size_t nbyte
             {
                 VALIDATE_ROW_DATA_D_F16_IMPL(block_q2_0, data, nb);
             } break;
+        case GGML_TYPE_Q12H:
+            {
+                // Q12H has no scale: the bf16 exponent byte is (u16 >> 7) & 0xFF,
+                // so an all-ones exponent byte in the LUT or an exception slot is
+                // exactly an inf/nan weight.
+                const block_q12h * q = (const block_q12h *) data;
+                for (size_t i = 0; i < nb; ++i) {
+                    for (int s = 0; s < 16; ++s) {
+                        if (q[i].lut[s] == 0xFF) {
+                            fprintf(stderr, "ggml_validate_row_data: found inf/nan exponent in lut at block %zu\n", i);
+                            return false;
+                        }
+                    }
+                    for (int s = 0; s < 4; ++s) {
+                        if (q[i].epos[s] == 0xFF) {
+                            break;
+                        }
+                        if (((q[i].eval[s] >> 7) & 0xFF) == 0xFF) {
+                            fprintf(stderr, "ggml_validate_row_data: found inf/nan exception value at block %zu\n", i);
+                            return false;
+                        }
+                    }
+                }
+            } break;
         case GGML_TYPE_Q4_0:
             {
                 VALIDATE_ROW_DATA_D_F16_IMPL(block_q4_0, data, nb);
